{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bruff-control": {
      "type": "streamable-http",
      "url": "https://lejxenmswcaddrnspxuf.supabase.co/functions/v1/bruff-control",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "openid",
              "email",
              "profile"
            ],
            "defaultScopes": [
              "openid",
              "email",
              "profile"
            ],
            "oidcEnabled": true,
            "oidcScopesSupported": [
              "openid",
              "email",
              "profile"
            ]
          }
        }
      }
    }
  }
}
